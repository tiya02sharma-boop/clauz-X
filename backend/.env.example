# Copy to backend/.env for local development. Do not commit backend/.env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEMO_MODE=true
PORT=5001
MONITOR_REQUEST_TIMEOUT=15
MAX_DOCUMENT_BYTES=10000000
# Enable for only one always-on backend instance. Use `python -m backend.monitor
# --once` in a platform scheduler for multi-instance deployments.
ENABLE_REGULATORY_MONITOR=false
MONITOR_INTERVAL_MINUTES=360
WASENDER_API_KEY=
