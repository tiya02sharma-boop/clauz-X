# ─────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT  →  copy this file to backend/.env
# RENDER DEPLOYMENT  →  paste these keys into Render's Environment
#                       Variables panel (never commit backend/.env)
# ─────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────
GEMINI_API_KEY=              # Get from https://aistudio.google.com/app/apikey
GEMINI_MODEL=gemini-2.5-flash

# ── Server ────────────────────────────────────────────────────────
# PORT is set automatically by Render — do NOT override it on Render.
# For local dev, set it here:
PORT=5001

# ── Mode ──────────────────────────────────────────────────────────
# Set to false in production so real LLM calls are made.
DEMO_MODE=false

# ── Document limits ───────────────────────────────────────────────
MAX_DOCUMENT_BYTES=10000000
MONITOR_REQUEST_TIMEOUT=15

# ── Regulatory monitor ────────────────────────────────────────────
# Keep false on Render web service (stateless). Use a separate Render
# Cron Job with command: python -m backend.monitor --once
ENABLE_REGULATORY_MONITOR=false
MONITOR_INTERVAL_MINUTES=360

# ── WhatsApp (WaSenderAPI) ────────────────────────────────────────
WASENDER_API_KEY=            # From https://wasenderapi.com/dashboard

# ── Public URL (required for WhatsApp callbacks & PDF links) ──────
# Set to your Render service URL once deployed, e.g.:
# PUBLIC_BASE_URL=https://clauzx-backend.onrender.com
PUBLIC_BASE_URL=

# ── Embeddings ────────────────────────────────────────────────────
EMBEDDING_DIM=768
